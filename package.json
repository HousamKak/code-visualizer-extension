{
  "name": "code-visualizer",
  "displayName": "Code Visualizer - AI Flow Diagrams",
  "description": "Instantly visualize code logic with AI-generated Mermaid diagrams. Hover over any function to see its flow.",
  "version": "2.0.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "flowchart",
    "visualization",
    "ai",
    "copilot",
    "code analysis",
    "documentation"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:php",
    "onLanguage:ruby",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:kotlin",
    "onLanguage:swift",
    "onLanguage:scala",
    "onLanguage:dart"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/",
    "media/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeVisualizer.showDiagram",
        "title": "Show Function Diagram",
        "category": "Code Visualizer",
        "icon": "$(symbol-method)"
      },
      {
        "command": "codeVisualizer.showDiagramPanel",
        "title": "Open Diagram in Side Panel",
        "category": "Code Visualizer",
        "icon": "$(open-preview)"
      },
      {
        "command": "codeVisualizer.storeApiToken",
        "title": "Configure API Token",
        "category": "Code Visualizer",
        "icon": "$(key)"
      },
      {
        "command": "codeVisualizer.clearCache",
        "title": "Clear Diagram Cache",
        "category": "Code Visualizer",
        "icon": "$(trash)"
      },
      {
        "command": "codeVisualizer.showAnalytics",
        "title": "Show Analytics",
        "category": "Code Visualizer",
        "icon": "$(graph-line)"
      },
      {
        "command": "codeVisualizer.exportDiagram",
        "title": "Export Diagram",
        "category": "Code Visualizer",
        "icon": "$(export)"
      },
      {
        "command": "codeVisualizer.configureDiagramType",
        "title": "Configure Diagram Types",
        "category": "Code Visualizer",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus && resourceExtname =~ /\\.(js|ts|jsx|tsx|py|cs|java|go|rs)$/",
          "command": "codeVisualizer.showDiagram",
          "group": "navigation@1"
        },
        {
          "when": "editorTextFocus && resourceExtname =~ /\\.(js|ts|jsx|tsx|py|cs|java|go|rs)$/",
          "command": "codeVisualizer.showDiagramPanel",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname =~ /\\.(js|ts|jsx|tsx|py|cs|java|go|rs)$/",
          "command": "codeVisualizer.showDiagramPanel",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codeVisualizer.showDiagram",
          "when": "editorIsOpen"
        },
        {
          "command": "codeVisualizer.showDiagramPanel",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeVisualizer.showDiagram",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "codeVisualizer.showDiagramPanel",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Code Visualizer",
      "properties": {
        "codeVisualizer.enableHover": {
          "type": "boolean",
          "description": "Enable automatic diagram generation on hover",
          "default": true
        },
        "codeVisualizer.provider": {
          "type": "string",
          "enum": ["github", "openai", "anthropic", "local"],
          "enumDescriptions": [
            "GitHub Models (Azure OpenAI)",
            "OpenAI GPT-4",
            "Anthropic Claude",
            "Local Ollama instance"
          ],
          "description": "AI provider for diagram generation",
          "default": "github"
        },
        "codeVisualizer.githubModel": {
          "type": "string",
          "enum": [
            "gpt-4o",
            "gpt-4.1",
            "gpt-4.1-mini",
            "gpt-5",
            "gpt-5-mini",
            "o3",
            "o3-mini",
            "claude-sonnet-4.5",
            "claude-3.7-sonnet",
            "claude-3.5-sonnet",
            "claude-haiku-4.5",
            "llama-3.3-70b-instruct",
            "llama-3.1-405b-instruct",
            "llama-4",
            "phi-4",
            "phi-4-mini-instruct",
            "deepseek-r1",
            "deepseek-v3",
            "grok-3",
            "grok-3-mini",
            "mistral-large",
            "cohere-command-a"
          ],
          "enumDescriptions": [
            "GPT-4 Omni - OpenAI's most advanced multimodal model (Recommended)",
            "GPT-4.1 - Major gains in coding, instruction following, and long-context",
            "GPT-4.1 Mini - Faster GPT-4.1 variant for quick tasks",
            "GPT-5 - Latest GPT generation for logic-heavy multi-step tasks",
            "GPT-5 Mini - Smaller GPT-5 for efficient processing",
            "O3 - Advanced reasoning model for complex logic and math",
            "O3 Mini - Smaller reasoning model, faster inference",
            "Claude Sonnet 4.5 - Anthropic's latest flagship model (Excellent for code)",
            "Claude 3.7 Sonnet - Anthropic's advanced reasoning model",
            "Claude 3.5 Sonnet - Anthropic's powerful multimodal model",
            "Claude Haiku 4.5 - Fast, efficient code generation with quality",
            "Llama 3.3 70B - Meta's latest 70B model with enhanced capabilities",
            "Llama 3.1 405B - Meta's largest and most capable open model",
            "Llama 4 - Meta's latest generation model",
            "Phi-4 14B - Microsoft's highly capable low-latency model",
            "Phi-4 Mini - Smaller Phi-4 variant for faster responses",
            "DeepSeek-R1 - Excels at reasoning, science, and coding tasks",
            "DeepSeek-V3 - Enhanced reasoning and code generation",
            "Grok 3 - xAI's most advanced reasoning model",
            "Grok 3 Mini - Faster Grok variant",
            "Mistral Large - Mistral's flagship model",
            "Cohere Command A - Cohere's advanced command model"
          ],
          "description": "GitHub Models API model selection (requires GitHub Copilot subscription, only used when provider is 'github')",
          "default": "gpt-4o"
        },
        "codeVisualizer.fallbackProviders": {
          "type": "boolean",
          "description": "Use fallback providers if primary fails",
          "default": true
        },
        "codeVisualizer.enableAnalytics": {
          "type": "boolean",
          "description": "Enable usage analytics and insights",
          "default": true
        },
        "codeVisualizer.autoExport": {
          "type": "boolean",
          "description": "Automatically export diagrams to workspace",
          "default": false
        },
        "codeVisualizer.preferredDiagramTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "flowchart",
              "sequence",
              "stateDiagram", 
              "classDiagram",
              "erDiagram",
              "journey",
              "mindmap",
              "timeline"
            ]
          },
          "description": "Preferred diagram types (empty for auto-selection)",
          "default": []
        },
        "codeVisualizer.apiToken": {
          "type": "string",
          "description": "API token (use 'Configure API Token' command for secure storage)",
          "default": "",
          "markdownDescription": "⚠️ **Security Warning**: Use the `Code Visualizer: Configure API Token` command instead for secure storage"
        },
        "codeVisualizer.maxFunctionSize": {
          "type": "number",
          "description": "Maximum function size in characters for diagram generation",
          "default": 5000,
          "minimum": 500,
          "maximum": 10000
        },
        "codeVisualizer.diagramTheme": {
          "type": "string",
          "enum": ["default", "dark", "forest", "neutral"],
          "enumDescriptions": [
            "Default Mermaid theme",
            "Dark theme for dark VS Code themes",
            "Forest green theme",
            "Neutral grayscale theme"
          ],
          "description": "Mermaid diagram color theme",
          "default": "dark"
        },
        "codeVisualizer.cacheEnabled": {
          "type": "boolean",
          "description": "Enable caching of generated diagrams",
          "default": true
        },
        "codeVisualizer.cacheDuration": {
          "type": "number",
          "description": "Cache duration in hours",
          "default": 24,
          "minimum": 1,
          "maximum": 168
        },
        "codeVisualizer.showIndicators": {
          "type": "boolean",
          "description": "Show visual indicators for functions with available diagrams",
          "default": true
        },
        "codeVisualizer.autoRetry": {
          "type": "boolean",
          "description": "Automatically retry failed diagram generations",
          "default": true
        },
        "codeVisualizer.retryCount": {
          "type": "number",
          "description": "Number of retry attempts for failed generations",
          "default": 3,
          "minimum": 1,
          "maximum": 5
        },
        "codeVisualizer.timeout": {
          "type": "number",
          "description": "Timeout for AI requests in seconds",
          "default": 10,
          "minimum": 5,
          "maximum": 30
        }
      }
    },
    "colors": [
      {
        "id": "codeVisualizer.decorationBackground",
        "description": "Background color for function indicators",
        "defaults": {
          "dark": "#1e1e1e",
          "light": "#f0f0f0"
        }
      }
    ],
    "icons": {
      "code-diagram": {
        "description": "Code diagram icon",
        "default": {
          "fontPath": "./icons/codicon.woff",
          "fontCharacter": "\\ea7b"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration --passWithNoTests",
    "test:e2e": "node ./out/test/runTest.js",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "20.x",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@vscode/test-electron": "^2.3.9",
    "typescript": "^4.9.4",
    "vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/housamkak/code-visualizer"
  },
  "bugs": {
    "url": "https://github.com/housamkak/code-visualizer/issues"
  },
  "homepage": "https://github.com/housamkak/code-visualizer#readme",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/VS%20Code-1.74%2B-blue",
      "href": "https://code.visualstudio.com/",
      "description": "Minimum VS Code version"
    }
  ],
  "qna": "https://github.com/housamkak/code-visualizer/discussions",
  "sponsor": {
    "url": "https://github.com/sponsors/housamkak"
  }
}