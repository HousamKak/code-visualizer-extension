{
  "name": "code-visualizer",
  "displayName": "Code Visualizer - AI Flow Diagrams",
  "description": "Instantly visualize code logic with AI-generated Mermaid diagrams. Hover over any function to see its flow.",
  "version": "2.0.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "flowchart",
    "visualization",
    "ai",
    "copilot",
    "code analysis",
    "documentation"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:php",
    "onLanguage:ruby",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:kotlin",
    "onLanguage:swift",
    "onLanguage:scala",
    "onLanguage:dart"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/",
    "media/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeVisualizer.showDiagram",
        "title": "Show Function Diagram",
        "category": "Code Visualizer",
        "icon": "$(symbol-method)"
      },
      {
        "command": "codeVisualizer.showDiagramPanel",
        "title": "Open Diagram in Side Panel",
        "category": "Code Visualizer",
        "icon": "$(open-preview)"
      },
      {
        "command": "codeVisualizer.storeApiToken",
        "title": "Configure API Token",
        "category": "Code Visualizer",
        "icon": "$(key)"
      },
      {
        "command": "codeVisualizer.clearCache",
        "title": "Clear Diagram Cache",
        "category": "Code Visualizer",
        "icon": "$(trash)"
      },
      {
        "command": "codeVisualizer.showAnalytics",
        "title": "Show Analytics",
        "category": "Code Visualizer",
        "icon": "$(graph-line)"
      },
      {
        "command": "codeVisualizer.exportDiagram",
        "title": "Export Diagram",
        "category": "Code Visualizer",
        "icon": "$(export)"
      },
      {
        "command": "codeVisualizer.configureDiagramType",
        "title": "Configure Diagram Types",
        "category": "Code Visualizer",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codeVisualizer.selectModel",
        "title": "Select AI Model",
        "category": "Code Visualizer",
        "icon": "$(hubot)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus && resourceExtname =~ /\\.(js|ts|jsx|tsx|py|cs|java|go|rs)$/",
          "command": "codeVisualizer.showDiagram",
          "group": "navigation@1"
        },
        {
          "when": "editorTextFocus && resourceExtname =~ /\\.(js|ts|jsx|tsx|py|cs|java|go|rs)$/",
          "command": "codeVisualizer.showDiagramPanel",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname =~ /\\.(js|ts|jsx|tsx|py|cs|java|go|rs)$/",
          "command": "codeVisualizer.showDiagramPanel",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codeVisualizer.showDiagram",
          "when": "editorIsOpen"
        },
        {
          "command": "codeVisualizer.showDiagramPanel",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeVisualizer.showDiagram",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "codeVisualizer.showDiagramPanel",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Code Visualizer",
      "properties": {
        "codeVisualizer.enableHover": {
          "type": "boolean",
          "description": "Enable automatic diagram generation on hover",
          "default": true
        },
        "codeVisualizer.provider": {
          "type": "string",
          "enum": ["github", "openai", "anthropic", "local"],
          "enumDescriptions": [
            "GitHub Models (Azure OpenAI)",
            "OpenAI GPT-4",
            "Anthropic Claude",
            "Local Ollama instance"
          ],
          "description": "AI provider for diagram generation",
          "default": "github"
        },
        "codeVisualizer.githubModel": {
          "type": "string",
          "enum": [
            "gpt-4.1",
            "gpt-5",
            "gpt-5-mini",
            "gpt-5-codex",
            "claude-haiku-4.5",
            "claude-opus-4.1",
            "claude-sonnet-4",
            "claude-sonnet-4.5",
            "gemini-2.5-pro",
            "grok-code-fast-1",
            "gpt-4o",
            "gpt-4o-mini",
            "gpt-4-turbo",
            "o1-preview",
            "o1-mini",
            "AI21-Jamba-1.5-Large",
            "AI21-Jamba-1.5-Mini",
            "Cohere-command-r",
            "Cohere-command-r-plus",
            "Meta-Llama-3-70B-Instruct",
            "Meta-Llama-3-8B-Instruct",
            "Meta-Llama-3.1-405B-Instruct",
            "Meta-Llama-3.1-70B-Instruct",
            "Meta-Llama-3.1-8B-Instruct",
            "Mistral-large",
            "Mistral-large-2407",
            "Mistral-Nemo",
            "Mistral-small",
            "Phi-3-medium-128k-instruct",
            "Phi-3-mini-128k-instruct",
            "Phi-3-small-128k-instruct",
            "Phi-3.5-mini-instruct",
            "Phi-3.5-MoE-instruct"
          ],
          "enumDescriptions": [
            "GPT-4.1 - OpenAI GA flagship",
            "GPT-5 - OpenAI newest flagship",
            "GPT-5 Mini - Lightweight GPT-5 tier",
            "GPT-5 Codex - OpenAI code-focused preview",
            "Claude Haiku 4.5 - Anthropic fast Claude variant",
            "Claude Opus 4.1 - Anthropic enterprise reasoning",
            "Claude Sonnet 4 - Anthropic balanced model",
            "Claude Sonnet 4.5 - Anthropic latest Sonnet release",
            "Gemini 2.5 Pro - Google multimodal GA",
            "Grok Code Fast 1 - xAI code model (preview)",
            "GPT-4 Omni - OpenAI's most advanced (Recommended)",
            "GPT-4 Omni Mini - Faster GPT-4o, good balance",
            "GPT-4 Turbo - Previous gen GPT-4",
            "O1 Preview - Reasoning model for complex logic",
            "O1 Mini - Smaller reasoning model",
            "Jamba 1.5 Large - AI21's hybrid architecture",
            "Jamba 1.5 Mini - Smaller Jamba variant",
            "Cohere Command R - Cohere's base model",
            "Cohere Command R Plus - More capable Cohere",
            "Llama 3 70B - Meta's 70B parameter model",
            "Llama 3 8B - Meta's efficient 8B model",
            "Llama 3.1 405B - Meta's largest (405B params)",
            "Llama 3.1 70B - Latest Llama 70B",
            "Llama 3.1 8B - Latest Llama 8B",
            "Mistral Large - Mistral's flagship",
            "Mistral Large 2407 - Updated Mistral Large",
            "Mistral Nemo - Efficient 12B model",
            "Mistral Small - Compact Mistral variant",
            "Phi-3 Medium 128K - MS 128K context",
            "Phi-3 Mini 128K - Compact with 128K context",
            "Phi-3 Small 128K - Smaller Phi-3 variant",
            "Phi-3.5 Mini - Latest mini Phi",
            "Phi-3.5 MoE - Mixture of Experts variant"
          ],
          "description": "GitHub Models API - Use exact model names (case-sensitive)",
          "default": "gpt-4o"
        },
        "codeVisualizer.fallbackProviders": {
          "type": "boolean",
          "description": "Try other AI providers (OpenAI, Anthropic) if GitHub fails. Disable to only use your selected GitHub model.",
          "default": false
        },
        "codeVisualizer.enableAnalytics": {
          "type": "boolean",
          "description": "Enable usage analytics and insights",
          "default": true
        },
        "codeVisualizer.autoExport": {
          "type": "boolean",
          "description": "Automatically export diagrams to workspace",
          "default": false
        },
        "codeVisualizer.preferredDiagramTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "flowchart",
              "sequence",
              "stateDiagram", 
              "classDiagram",
              "erDiagram",
              "journey",
              "mindmap",
              "timeline"
            ]
          },
          "description": "Preferred diagram types (empty for auto-selection)",
          "default": []
        },
        "codeVisualizer.apiToken": {
          "type": "string",
          "description": "API token (use 'Configure API Token' command for secure storage)",
          "default": "",
          "markdownDescription": "⚠️ **Security Warning**: Use the `Code Visualizer: Configure API Token` command instead for secure storage"
        },
        "codeVisualizer.maxFunctionSize": {
          "type": "number",
          "description": "Maximum function size in characters for diagram generation",
          "default": 5000,
          "minimum": 500,
          "maximum": 10000
        },
        "codeVisualizer.diagramTheme": {
          "type": "string",
          "enum": ["default", "dark", "forest", "neutral"],
          "enumDescriptions": [
            "Default Mermaid theme",
            "Dark theme for dark VS Code themes",
            "Forest green theme",
            "Neutral grayscale theme"
          ],
          "description": "Mermaid diagram color theme",
          "default": "dark"
        },
        "codeVisualizer.cacheEnabled": {
          "type": "boolean",
          "description": "Enable caching of generated diagrams",
          "default": true
        },
        "codeVisualizer.cacheDuration": {
          "type": "number",
          "description": "Cache duration in hours",
          "default": 24,
          "minimum": 1,
          "maximum": 168
        },
        "codeVisualizer.showIndicators": {
          "type": "boolean",
          "description": "Show visual indicators for functions with available diagrams",
          "default": true
        },
        "codeVisualizer.autoRetry": {
          "type": "boolean",
          "description": "Automatically retry failed diagram generations",
          "default": true
        },
        "codeVisualizer.retryCount": {
          "type": "number",
          "description": "Number of retry attempts for failed generations",
          "default": 3,
          "minimum": 1,
          "maximum": 5
        },
        "codeVisualizer.timeout": {
          "type": "number",
          "description": "Timeout for AI requests in seconds",
          "default": 10,
          "minimum": 5,
          "maximum": 30
        }
      }
    },
    "colors": [
      {
        "id": "codeVisualizer.decorationBackground",
        "description": "Background color for function indicators",
        "defaults": {
          "dark": "#1e1e1e",
          "light": "#f0f0f0"
        }
      }
    ],
    "icons": {
      "code-diagram": {
        "description": "Code diagram icon",
        "default": {
          "fontPath": "./icons/codicon.woff",
          "fontCharacter": "\\ea7b"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration --passWithNoTests",
    "test:e2e": "node ./out/test/runTest.js",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "20.x",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@vscode/test-electron": "^2.3.9",
    "typescript": "^4.9.4",
    "vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/housamkak/code-visualizer"
  },
  "bugs": {
    "url": "https://github.com/housamkak/code-visualizer/issues"
  },
  "homepage": "https://github.com/housamkak/code-visualizer#readme",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/VS%20Code-1.74%2B-blue",
      "href": "https://code.visualstudio.com/",
      "description": "Minimum VS Code version"
    }
  ],
  "qna": "https://github.com/housamkak/code-visualizer/discussions",
  "sponsor": {
    "url": "https://github.com/sponsors/housamkak"
  }
}
